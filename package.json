{
  "name": "@dkmaker/ai-debug",
  "version": "0.1.0",
  "description": "AI-optimized debugging and caching system for Node.js applications with minimal repository footprint",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "bin": {
    "ai-debug": "./dist/cli/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check --write .",
    "lint:fix": "biome check --write --unsafe .",
    "prepublishOnly": "pnpm run build && pnpm test"
  },
  "keywords": [
    "debug",
    "debugging",
    "cache",
    "ai",
    "claude",
    "logging",
    "performance",
    "development",
    "devtools"
  ],
  "author": "DKMaker",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac",
  "dependencies": {
    "@babel/parser": "^7.27.5",
    "@babel/traverse": "^7.27.4",
    "chalk": "^5.4.1",
    "commander": "^12.1.0",
    "glob": "^11.0.3",
    "inquirer": "^10.2.2",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/babel__traverse": "^7.20.7",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "^2.1.8",
    "tsup": "^8.5.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dkmaker/ai-debug.git"
  },
  "bugs": {
    "url": "https://github.com/dkmaker/ai-debug/issues"
  },
  "homepage": "https://github.com/dkmaker/ai-debug#readme"
}
