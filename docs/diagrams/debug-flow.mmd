
%%{init: {
  "theme": "base",
  "themeVariables": {
    "primaryColor": "#4A90E2",
    "primaryTextColor": "#FFFFFF",
    "primaryBorderColor": "#357ABD",
    "lineColor": "#666666",
    "secondaryColor": "#F5F5F5",
    "tertiaryColor": "#E8E8E8",
    "background": "#FFFFFF",
    "mainBkg": "#4A90E2",
    "secondBkg": "#71B340",
    "tertiaryBkg": "#F39C12"
  }
}}%%
graph TD

    Start("debug.wrap() called"(
    Init["Initialize debug context"]
    Template{"Select template"}
    Execute["Execute wrapped function"]
    Success{"Operation successful?"}
    ProcessResult["Process result data"]
    ProcessError["Process error data"]
    Cache["Update cache"]
    Log["Write to log"]
    Persist["Persist debug data"]
    Return("Return result"(

    Start --> Init
    Init --> Template
    Template --> Execute
    Execute --> Success
    Success -->|Yes| ProcessResult
    Success -->|No| ProcessError
    ProcessResult --> Cache
    ProcessError --> Log
    Cache --> Log
    Log --> Persist
    Persist --> Return

    %% Styling
    classDef start fill:#71B340,stroke:#5A8A32,stroke-width:2px,color:#fff
    classDef process fill:#4A90E2,stroke:#357ABD,stroke-width:2px,color:#fff
    classDef decision fill:#F39C12,stroke:#E67E22,stroke-width:2px,color:#fff
    classDef end fill:#E74C3C,stroke:#C0392B,stroke-width:2px,color:#fff
    class Start start
    class Init,Execute,ProcessResult,ProcessError,Cache,Log,Persist process
    class Template,Success decision
    class Return end